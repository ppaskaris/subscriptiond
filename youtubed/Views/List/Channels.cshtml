@model ListViewModel

@{
    ViewData["Title"] = "Manage Channels";
    var listId = Model.Id;
    var listToken = Model.Token;
}

<div class="list-header">
    <h1>@ViewData["Title"]</h1>
    <div class="list-actions" aria-label="Channel actions">
        <a class="btn btn-secondary btn-icon" asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId" title="Back">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left-circle" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-4.5-.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
            <span class="sr-only">Back</span>
        </a>
        <a class="btn btn-primary btn-icon" asp-action="AddChannel" asp-route-token="@listToken" asp-route-id="@listId" title="Add Channel">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
            </svg>
            <span class="sr-only">Add Channel</span>
        </a>
    </div>
</div>
<p>
    Channels in <a asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId">@Model.Title</a>.
</p>

@if (Model.Channels.Any())
{
    <ol class="list-unstyled channel-list">
        @foreach (var channel in Model.Channels)
        {
            <li class="channel-item">
                <a class="channel-link" href="@channel.Url" rel="noopener noreferrer" referrerpolicy="no-referrer">
                    <img src="@channel.Thumbnail" referrerpolicy="no-referrer" width="135" height="135" loading="lazy" />
                    <span class="channel-title">@channel.Title</span>
                </a>
                <form asp-action="RemoveChannel" asp-route-token="@listToken" asp-route-id="@listId">
                    <input type="hidden" name="ChannelId" value="@channel.Id" />
                    <input type="submit" value="Remove Channel" class="btn btn-danger btn-block" />
                </form>
            </li>
        }
    </ol>
}
else
{
    <p>
        <em>No channels added.</em>
    </p>
}
