@model ListViewModel

@{
    ViewData["Title"] = "Manage Channels";
    var listId = Model.Id;
    var listToken = Model.Token;
}

<h1>@ViewData["Title"]</h1>
<p>
    Channels in <a asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId">@Model.Title</a>.
</p>

@if (Model.Channels.Any())
{
    <ol class="list-unstyled channel-list">
        @foreach (var channel in Model.Channels)
        {
            <li class="channel-item">
                <a class="channel-link" href="@channel.Url" rel="noopener noreferrer" referrerpolicy="no-referrer">
                    <img src="@channel.Thumbnail" referrerpolicy="no-referrer" width="135" height="135" loading="lazy" />
                    <span class="channel-title">@channel.Title</span>
                </a>
                <form asp-action="RemoveChannel" asp-route-token="@listToken" asp-route-id="@listId">
                    <input type="hidden" name="ChannelId" value="@channel.Id" />
                    <input type="submit" value="Remove Channel" class="btn btn-danger btn-block" />
                </form>
            </li>
        }
    </ol>
}
else
{
    <p>
        <em>No channels added.</em>
    </p>
}

<p>
    <a class="btn btn-secondary" asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId">Back</a>
    <a class="btn btn-primary" asp-action="AddChannel" asp-route-token="@listToken" asp-route-id="@listId">Add New Channel</a>
</p>
