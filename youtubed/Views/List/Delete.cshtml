@model ListModel

@{
    ViewData["Title"] = "Delete List";
    var listId = ViewContext.RouteData.Values["id"];
    var listToken = ViewContext.RouteData.Values["token"];
}

<h1>@ViewData["Title"]</h1>
<p>
    Your list named "@Model.Title" will be deleted immediately and will not be
    recoverable.
</p>
<p>Are you sure you want to delete your list?</p>
<form asp-action="Delete" asp-route-token="@listToken" asp-route-id="@listId">
    <input type="hidden" name="Confirm" value="true" />
    <input type="submit" value="Delete List" class="btn btn-danger" />
    <a asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId" class="btn btn-secondary">Cancel</a>
</form>
