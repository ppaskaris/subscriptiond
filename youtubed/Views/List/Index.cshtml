@model ListViewModel
@using System.Net

@{
    ViewData["Title"] = Model.Title;
    var listId = Model.Id;
    var listToken = Model.Token;
}

@section Meta {
    @if (Model.StaleCount > 0)
    {
        <meta http-equiv="refresh"
              content="@Math.Floor(Constants.RandomlyBetween(Constants.ChannelUpdateFrequencyMin, Constants.ChannelUpdateFrequencyMax).TotalSeconds)">
    }
}

<h1>@ViewData["Title"]</h1>
<p>
    This is a <strong>secret list</strong> that is only visible to those with a
    copy of <a asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId">this link</a>. Consider bookmarking it as it
    cannot be recovered if you lose it.
</p>
<p>
    If you do not access this list again within <time datetime="@Model.ExpiredAfter.ToString("o")" title="@Model.ExpiredAfter.ToString("g")">@Model.MaxAge.Humanize()</time>,
    it will be automatically deleted.
</p>

<h2>Videos</h2>
@if (Model.StaleCount > 0)
{
    <div class="alert alert-info" role="alert">
        @("channel".ToQuantity(Model.StaleCount)) in this list @("is".ToQuantity(Model.StaleCount, ShowQuantityAs.None))
        waiting to be updated. <a class="alert-link" asp-action="Index" asp-route-token="@listToken" asp-route-id="@listId">Refresh</a>
    </div>
}
@{
    var videoCount = Model.Videos.Count();
    var renderedVideos = Model.Videos.Take(Constants.ListRenderMaxItems).ToList();
}
@if (videoCount > 0)
{
    <ol class="list-unstyled video-list">
        @foreach (var video in renderedVideos)
        {
            <li class="video-item">
                <a class="video-link" href="@video.GetWatchUrl(Model.PlaybackRate)" target="_blank" rel="noopener">
                    <div class="video-image">
                        <img src="@video.VideoThumbnail" referrerpolicy="no-referrer" width="224" height="126" loading="lazy" />
                        <span class="video-duration">@video.FormattedVideoDuration</span>
                    </div>
                    <span class="video-title">@WebUtility.HtmlDecode(video.VideoTitle)</span>
                </a>
                <a class="video-channel-link" href="@video.ChannelUrl" rel="noopener noreferrer" referrerpolicy="no-referrer">@video.ChannelTitle</a>
                <time class="video-published-at" datetime="@video.VideoPublishedAt.ToString("o")" title="@video.VideoPublishedAt.ToString("g")">@video.VideoPublishedAt.Humanize()</time>
            </li>
        }
        <li class="video-item video-item-filler" aria-hidden="true"></li>
    </ol>
    @if (videoCount > Constants.ListRenderMaxItems)
    {
        <div class="alert alert-info">
            Showing <strong>@Constants.ListRenderMaxItems</strong> of <strong>@videoCount</strong> total videos in this list.
        </div>
    }
}
else
{
    <p>
        <em>No recent videos.</em>
    </p>
}

<h2>Channels</h2>
@if (Model.Channels.Any())
{
    <ol class="list-unstyled channel-list">
        @foreach (var channel in Model.Channels)
        {
            <li class="channel-item">
                <a class="channel-link" href="@channel.Url" rel="noopener noreferrer" referrerpolicy="no-referrer">
                    <img src="@channel.Thumbnail" referrerpolicy="no-referrer" width="135" height="135" loading="lazy" />
                    <span class="channel-title">@channel.Title</span>
                </a>
                <form asp-action="RemoveChannel" asp-route-token="@listToken" asp-route-id="@listId">
                    <input type="hidden" name="ChannelId" value="@channel.Id" />
                    <input type="submit" value="Remove Channel" class="btn btn-danger btn-block" />
                </form>
            </li>
        }
    </ol>
}
else
{
    <p>
        <em>No channels added.</em>
    </p>
}
<p>
    <a class="btn btn-secondary" asp-action="AddChannel" asp-route-token="@listToken" asp-route-id="@listId">Add New Channel</a>
</p>

<h2>Settings</h2>
<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-token="@listToken" asp-route-id="@listId">Edit List</a>
    <a class="btn btn-secondary" asp-action="Share" asp-route-token="@listToken" asp-route-id="@listId">Share List</a>
    <a class="btn btn-danger" asp-action="Delete" asp-route-token="@listToken" asp-route-id="@listId">Delete List</a>
</p>
