@model ShareListViewModel

@{
    ViewData["Title"] = "Share";
}

<h1>Share @Model.Title</h1>
<p>
    Create a short one-time share link to open this list on another device.
    Type or copy the link exactly as shown below. Each link works once and
    expires in about <strong>1 hour</strong>.
</p>

@if (Model.HasLinks)
{
    <ol class="list-unstyled">
        @foreach (var shareLink in Model.ShareLinks)
        {
            var statusClass = shareLink.Status == "Active"
                ? "badge badge-success"
                : shareLink.Status == "Used"
                    ? "badge badge-secondary"
                    : "badge badge-warning";
            <li class="card mb-3">
                <div class="card-body">
                    <div class="form-group">
                        <label>Share link <span class="@statusClass">@shareLink.Status</span></label>
                        <input class="form-control" readonly value="@shareLink.ShareUrl" />
                        @if (shareLink.UsedAt != null)
                        {
                            <p class="text-muted small">Used <time datetime="@shareLink.UsedAt.Value.ToString("o")" title="@shareLink.UsedAt.Value.ToString("g")">@shareLink.UsedAt.Value.Humanize()</time>.</p>
                        }
                        else
                        {
                            <p class="text-muted small">Expires <time datetime="@shareLink.ExpiresAfter.ToString("o")" title="@shareLink.ExpiresAfter.ToString("g")">@shareLink.ExpiresAfter.Humanize()</time>.</p>
                        }
                    </div>
                    <form asp-action="DeleteShareLink" asp-route-token="@Model.Token" asp-route-id="@Model.ListId" class="d-inline-block">
                        <input type="hidden" name="password" value="@shareLink.Password" />
                        <input type="submit" value="Delete" class="btn btn-danger btn-sm" />
                    </form>
                </div>
            </li>
        }
    </ol>
}
else
{
    <p>
        <em>No share links yet.</em>
    </p>
}

<div class="d-flex flex-wrap align-items-center">
    <a class="btn btn-secondary mr-2 mb-2" asp-action="Index" asp-route-token="@Model.Token" asp-route-id="@Model.ListId">Back</a>
    <form asp-action="CreateShareLink" asp-route-token="@Model.Token" asp-route-id="@Model.ListId" class="mr-2 mb-2">
        <input type="submit" value="Create share link" class="btn btn-primary" />
    </form>
    <form asp-action="DeleteAllShareLinks" asp-route-token="@Model.Token" asp-route-id="@Model.ListId" class="mb-2">
        <input type="submit" value="Delete all share links" class="btn btn-danger" @(Model.HasLinks ? null : "disabled") />
    </form>
</div>
