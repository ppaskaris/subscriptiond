@model ShareListViewModel

@{
    ViewData["Title"] = "Share";
}

<div class="list-header">
    <h1>Share @Model.Title</h1>
    <div class="list-actions" aria-label="Share actions">
        <a class="btn btn-secondary btn-icon" asp-action="Index" asp-route-token="@Model.Token" asp-route-id="@Model.ListId" title="Back">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left-circle" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-4.5-.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
            <span class="sr-only">Back</span>
        </a>
        @if (Model.ShareCreationEnabled)
        {
            <form asp-action="CreateShareLink" asp-route-token="@Model.Token" asp-route-id="@Model.ListId">
                <button type="submit" class="btn btn-primary btn-icon" title="Create share link">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                </svg>
                <span class="sr-only">Create share link</span>
                </button>
            </form>
        }
        <form asp-action="DeleteAllShareLinks" asp-route-token="@Model.Token" asp-route-id="@Model.ListId">
            <button type="submit" class="btn btn-danger btn-icon" title="Delete all share links" @(Model.HasLinks ? null : "disabled")>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-folder-x" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181L15.546 8H14.54l.265-2.91A1 1 0 0 0 13.81 4H2.19a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91H9v1H2.826a2 2 0 0 1-1.991-1.819l-.637-7a2 2 0 0 1 .342-1.31zm6.339-1.577A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139q.323-.119.684-.12h5.396z" />
                    <path d="M11.854 10.146a.5.5 0 0 0-.707.708L12.293 12l-1.146 1.146a.5.5 0 0 0 .707.708L13 12.707l1.146 1.147a.5.5 0 0 0 .708-.708L13.707 12l1.147-1.146a.5.5 0 0 0-.707-.708L13 11.293z" />
                </svg>
                <span class="sr-only">Delete all share links</span>
            </button>
        </form>
    </div>
</div>
@if (!Model.ShareCreationEnabled)
{
    <p class="alert alert-info" role="status">
        New share links are temporarily unavailable during maintenance. Existing links can still be used or deleted.
    </p>
}
<p>
    Create a short one-time share link to open this list on another device.
    Type or copy the link exactly as shown below. Each link works once and
    expires in about <strong>1 hour</strong>.
</p>

@if (Model.HasLinks)
{
    <ol class="list-unstyled">
        @foreach (var shareLink in Model.ShareLinks)
        {
            var statusClass = shareLink.Status == "Active"
                ? "badge badge-success"
                : shareLink.Status == "Used"
                    ? "badge badge-secondary"
                    : "badge badge-warning";
            <li class="card mb-3">
                <div class="card-body">
                    <div class="form-group">
                        <label>Share link <span class="@statusClass">@shareLink.Status</span></label>
                        <input class="form-control" readonly value="@shareLink.ShareUrl" />
                        @if (shareLink.UsedAt != null)
                        {
                            <p class="text-muted small">Used <time datetime="@shareLink.UsedAt.Value.ToString("o")" title="@shareLink.UsedAt.Value.ToString("g")">@shareLink.UsedAt.Value.Humanize()</time>.</p>
                        }
                        else
                        {
                            <p class="text-muted small">Expires <time datetime="@shareLink.ExpiresAfter.ToString("o")" title="@shareLink.ExpiresAfter.ToString("g")">@shareLink.ExpiresAfter.Humanize()</time>.</p>
                        }
                    </div>
                    <form asp-action="DeleteShareLink" asp-route-token="@Model.Token" asp-route-id="@Model.ListId" class="d-inline-block">
                        <input type="hidden" name="password" value="@shareLink.Password" />
                        <input type="submit" value="Delete" class="btn btn-danger btn-sm" />
                    </form>
                </div>
            </li>
        }
    </ol>
}
else
{
    <p>
        <em>No share links yet.</em>
    </p>
}

