<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer">
    @RenderSection("Meta", required: false)
    <title>@ViewData["Title"] - subscriptiond</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css"
          referrerpolicy="no-referrer"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand">subscriptiond</a>
            <ul class="navbar-nav">
                <li class="nav-item @Url.ActiveClass("Home", "About")">
                    <a asp-area="" asp-controller="Home" asp-action="About" class="nav-link">About</a>
                </li>
            </ul>
        </div>
    </nav>
    <div class="container py-4">
        @RenderBody()
        <hr />
        <footer class="d-sm-flex justify-content-between align-items-center">
            <span class="d-block mb-2 mb-sm-0">&copy; @DateTime.UtcNow.Year - subscriptiond v@(youtubed.AppVersion.Current)</span>
            <a href="https://www.youtube.com" rel="noopener noreferrer" referrerpolicy="no-referrer" target="_blank" class="d-inline-block">
                <img src="~/images/yt-attribution.png" alt="Developed with YouTube" width="159" height="20" loading="lazy" />
            </a>
        </footer>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
