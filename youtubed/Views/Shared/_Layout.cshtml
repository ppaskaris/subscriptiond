<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer">
    @RenderSection("Meta", required: false)
    <title>@ViewData["Title"] - subscriptiond</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.min.css"
          referrerpolicy="no-referrer"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-inverse">
        <div class="container">
            <div class="navbar-header">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand">subscriptiond</a>
            </div>
            <div class="navbar-collapse">
                <ul class="nav navbar-nav">
                    <li class="@Url.ActiveClass("Home", "About")"><a asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <span class="pull-left">&copy; @DateTime.UtcNow.Year - subscriptiond v@(youtubed.AppVersion.Current)</span>
            <a href="https://www.youtube.com" rel="noopener noreferrer" referrerpolicy="no-referrer" target="_blank">
                <img class="pull-right" src="~/images/yt-attribution.png" alt="Developed with YouTube" width="159" height="20" loading="lazy" />
            </a>
            <div class="clearfix"></div>
        </footer>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
