@model youtubed.Models.WatchViewModel
@using System.Net
@{
    Layout = null;
    var embedUrl = string.Format(Constants.YoutubeEmbedUrl, Model.VideoId) + "?enablejsapi=1";
    var decodedTitle = string.IsNullOrWhiteSpace(Model.VideoTitle)
        ? null
        : WebUtility.HtmlDecode(Model.VideoTitle);
    var documentTitle = string.IsNullOrWhiteSpace(decodedTitle)
        ? "Watch - subscriptiond"
        : $"{decodedTitle} - subscriptiond";
    var playbackRate = Constants.FormatPlaybackRate(Model.PlaybackRate);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>@documentTitle</title>
    <style>
        html, body {
            margin: 0;
            height: 100%;
            background: #000;
        }

        .watch-frame {
            border: 0;
            width: 100%;
            height: 100%;
            display: block;
        }
    </style>
</head>
<body>
    <iframe id="watch-player"
            class="watch-frame"
            src="@embedUrl"
            title="YouTube video player"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
    <script>
        let watchPlayer;

        function onYouTubeIframeAPIReady() {
            watchPlayer = new YT.Player('watch-player', {
                events: {
                    onReady: onWatchPlayerReady
                }
            });
        }

        function onWatchPlayerReady(event) {
            event.target.setPlaybackRate(@playbackRate);
        }
    </script>
    <script src="https://www.youtube.com/iframe_api"></script>
</body>
</html>
