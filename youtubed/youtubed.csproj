<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>6a3676e8-3e2c-4433-976f-4e27f06e1306</UserSecretsId>
    <AssemblyVersion>2.0.4.0</AssemblyVersion>
    <NpmCommand Condition="'$(OS)' == 'Windows_NT'">npm.cmd</NpmCommand>
    <NpmCommand Condition="'$(OS)' != 'Windows_NT'">npm</NpmCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.0.123" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.70.0.3847" />
    <PackageReference Include="Humanizer.Core" Version="2.13.14" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.AzureAppServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Views\Shared\" />
    <Folder Include="wwwroot\css\" />
    <Folder Include="Assets\css\" />
  </ItemGroup>

  <Target Name="NpmInstall"
          BeforeTargets="Build;Publish"
          Inputs="package.json;package-lock.json"
          Outputs="node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(NpmCommand) install"
          Condition="!Exists('package-lock.json')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(NpmCommand) ci"
          Condition="Exists('package-lock.json')" />
  </Target>

  <Target Name="BuildCssAssets"
          BeforeTargets="Build;Publish"
          DependsOnTargets="NpmInstall"
          Inputs="Assets\css\site.css;package.json;package-lock.json"
          Outputs="wwwroot\css\site.css">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(NpmCommand) run build:css" />
  </Target>

</Project>
